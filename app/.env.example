# Arquivo de exemplo de configuração para variáveis de ambiente
# Copie este arquivo para .env e preencha com suas configurações reais

# PostgreSQL - Configuração do banco de dados CVM
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=cvm_database
POSTGRESQL_USER=cvm_user
POSTGRESQL_PASSWORD=seu_password_aqui

# URL completa do PostgreSQL (alternative to individual settings above)
# Formato: postgresql://user:password@host:port/database
POSTGRESQL_CVM_URL=postgresql://cvm_user:cvm_password@localhost:5432/cvm_database

# Configurações de scraping CVM
CVM_IMPORT_START_YEAR=2017
CVM_BATCH_SIZE_COMPANIES=100
CVM_BATCH_SIZE_FINANCIAL=50

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log

